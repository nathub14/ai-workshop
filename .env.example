# Required: your OpenAI API key (set a monthly spend limit on it in the OpenAI dashboard)
OPENAI_API_KEY=sk-...

# The model to use. Must support the web_search and image_generation tools in the Responses API.
OPENAI_MODEL=gpt-4.1

# Optional: a stronger model just for Build mode (better-looking websites and slides, a bit slower)
# OPENAI_BUILDER_MODEL=

# Code kids type on the first screen (write it on the whiteboard)
ACCESS_CODE=launch2026

# Password for /admin, where you edit the hidden prompts
ADMIN_PASSWORD=change-me

# Added automatically when you connect a Vercel Blob store to the project.
# Leave unset locally: files are then saved in a .data folder instead.
# BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public" - match the access type you chose when creating the Blob store
# BLOB_ACCESS=private
